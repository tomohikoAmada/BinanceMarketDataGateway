[Unit]
Description=BMDG - Binance Market Data Gateway
Documentation=https://github.com/tomohikoAmada/BinanceMarketDataGateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Create a dedicated account, e.g.:
#   useradd --system --home /nonexistent --shell /usr/sbin/nologin bmdg
User=bmdg
Group=bmdg
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ExecStart=/opt/bmdg/current/bin/bmdg --config /etc/bmdg/gateway.json
Restart=on-failure
# Shared-IP API budget is in-memory while Binance counters persist. Keep a full
# quiet window before restarting after a crash or replacement.
RestartSec=300
TimeoutStopSec=60
KillSignal=SIGTERM
LimitNOFILE=4096
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/bmdg
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
